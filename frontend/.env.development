# Loaded by plain `npm run dev` (Vite mode "development"). Runs fully offline
# against the in-memory mock transport — see src/api/mockTransport.ts.
VITE_USE_MOCKS=true
VITE_ENV=dev
VITE_API_BASE_URL=http://localhost:0
VITE_CDN_BASE_URL=http://localhost:0
VITE_COGNITO_USER_POOL_ID=us-east-1_MOCKPOOL
VITE_COGNITO_CLIENT_ID=mock-client-id
VITE_COGNITO_BOOTSTRAP_CLIENT_ID=mock-bootstrap-client-id
VITE_COGNITO_HOSTED_DOMAIN=mock.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_URI=
VITE_BUILD_SHA=dev
