# Loaded by `vite build --mode e2e` (`playwright.config.ts`'s `webServer`,
# mock project). Same shape as `.env.development` — fully offline, mock
# transport — except the origins are realistic-looking `https://` hosts
# rather than `http://localhost:0`, so the built CSP meta tag (`src/build/csp.ts`)
# has real origins to assert on in `e2e/mock/csp.spec.ts`.
VITE_USE_MOCKS=true
VITE_ENV=dev
VITE_API_BASE_URL=https://api.e2e.opennewsletter.test
VITE_MEDIA_BASE_URL=https://media.e2e.opennewsletter.test
VITE_UPLOAD_ORIGINS=https://uploads.e2e.opennewsletter.test
VITE_COGNITO_USER_POOL_ID=us-east-1_E2EPOOL
VITE_COGNITO_CLIENT_ID=e2e-client-id
VITE_COGNITO_BOOTSTRAP_CLIENT_ID=e2e-bootstrap-client-id
VITE_COGNITO_HOSTED_DOMAIN=e2e.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_URI=
VITE_BUILD_SHA=e2e
